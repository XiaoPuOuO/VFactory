+            conflicts.push({
+              agentId,
+              scheduleIdA: a.id,
+              scheduleIdB: b.id,
+              nextFireAtA: bestPair.ta.toISOString(),
+              nextFireAtB: bestPair.tb.toISOString(),
+              deltaSec: bestDelta,
+            });
+          }
+        }
