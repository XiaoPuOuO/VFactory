# 本機開發用 127.0.0.1；僅在 Docker Compose 同網路內才用容器主機名（例如 shared-postgres）
DATABASE_URL=
PAPERCLIP_REDIS_URL=

PORT=3100
SERVE_UI=true

# 未設定則無法為 Agent 注入 PAPERCLIP_API_KEY（無法呼叫 Paperclip API）
PAPERCLIP_AGENT_JWT_SECRET=
PAPERCLIP_ALERT_WEBHOOK_SECRET=

# ── 執行 / 遷移 ──────────────────────────────────────────────────────────
# 非互動環境自動套用 DB migration（launchd / CI 建議設 true）
PAPERCLIP_MIGRATION_AUTO_APPLY=true

# Google OAuth（兩者皆設定時才會顯示「使用 Google 登入」）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

PAPERCLIP_PUBLIC_URL=http://127.0.0.1:3100
PAPERCLIP_BROWSER_USE_SERVICE_URL=http://127.0.0.1:3001
PAPERCLIP_BROWSER_USE_SERVICE_SECRET=paperclip-browser-use-service-secret
PAPERCLIP_BROWSER_USE_SERVICE_TOKEN=paperclip-browser-use-service-token
# Redis (required for cost cache + browser-use nonce replay protection in multi-instance deployments)
PAPERCLIP_REDIS_URL=redis://127.0.0.1:6379
# Optional override for browser-use nonce store (defaults to PAPERCLIP_REDIS_URL)
PAPERCLIP_BROWSER_USE_NONCE_REDIS_URL=
# Optional: enable cost cache hit/miss debug logs
PAPERCLIP_COST_CACHE_DEBUG=false
# 設為 true/1/yes 時 Browser-Use 以可見視窗執行（方便觀察）；未設或 false 則 headless。Python 服務建議設相同值。
PAPERCLIP_BROWSER_USE_DEBUG=false

PAPERCLIP_ALLOWED_ATTACHMENT_TYPES=image/*,text/*,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/json

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# ── 聊天室「快速新增對話」自動標題（不經 heartbeat）────────────────────────────
# 設為 1/true 時關閉自動命名（仍保留預設房名直到使用者手動改名）。
# CHAT_SESSION_TITLE_DISABLED=0
# 自架輕量 HTTP「adapter」：POST JSON { intent, systemPrompt, userMessage }，回傳 JSON { title } 或純文字一行。
# CHAT_SESSION_TITLE_ADAPTER_URL=
# CHAT_SESSION_TITLE_ADAPTER_BEARER=
# CHAT_SESSION_TITLE_ADAPTER_TIMEOUT_MS=25000
# 未設定 ADAPTER_URL 時，若有 OpenAI key 則用 chat completions（模型可覆寫）。
# OPENAI_API_KEY=
# CHAT_SESSION_TITLE_OPENAI_API_KEY=
# CHAT_SESSION_TITLE_OPENAI_MODEL=gpt-4o-mini

# ── 作業流程 prompt 步驟：依執行 Agent 的 adapter 呼叫對應 API 產生「步驟結果」寫入 output 變數 ──
# 路由：gemini_* → GEMINI_API_KEY／GOOGLE_API_KEY；claude_* → ANTHROPIC_API_KEY；
# codex_*／opencode_local／pi_local／cursor(依 model) → OPENAI 相容；無 agent 或 process／http／openclaw → 沿用 OPENAI（WORKFLOW_PROMPT_OPENAI_API_KEY 或 OPENAI_API_KEY）。
# 未設定對應 key 或設 WORKFLOW_PROMPT_LLM_DISABLED=1 時，prompt 步驟將回傳空字串（或走 worker/session 路徑）。
# WORKFLOW_PROMPT_OPENAI_API_KEY=
# WORKFLOW_PROMPT_OPENAI_MODEL=gpt-4o-mini
# WORKFLOW_PROMPT_ANTHROPIC_MODEL=
# WORKFLOW_PROMPT_GEMINI_MODEL=
# WORKFLOW_PROMPT_OPENAI_MAX_TOKENS=8192
# WORKFLOW_PROMPT_OPENAI_TIMEOUT_MS=120000
# WORKFLOW_PROMPT_LLM_DISABLED=0
# 設為 1 時，Agent 可搭配 X-Paperclip-Workflow-Chat-Override: 1 略過「workflow 進行中禁聊天」409（本機除錯）
# WORKFLOW_CHAT_AGENT_OVERRIDE=
# 設為 1 時，prompt 步驟可改由 server HTTP LLM 填字（與 worker／agent session 路徑並存時作為後援）。
# 未設定或 0 時，有 agent 的 run 以 waiting_worker + adapter session 為主。
# WORKFLOW_SERVER_PROMPT_LLM=0