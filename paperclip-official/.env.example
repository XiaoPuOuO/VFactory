# 本機開發用 127.0.0.1；僅在 Docker Compose 同網路內才用容器主機名（例如 shared-postgres）
DATABASE_URL=
PAPERCLIP_REDIS_URL=

PORT=3100
SERVE_UI=true

# 未設定則無法為 Agent 注入 PAPERCLIP_API_KEY（無法呼叫 Paperclip API）
PAPERCLIP_AGENT_JWT_SECRET=

# ── 執行 / 遷移 ──────────────────────────────────────────────────────────
# 非互動環境自動套用 DB migration（launchd / CI 建議設 true）
PAPERCLIP_MIGRATION_AUTO_APPLY=true

# Google OAuth（兩者皆設定時才會顯示「使用 Google 登入」）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

PAPERCLIP_PUBLIC_URL=http://127.0.0.1:3100
PAPERCLIP_BROWSER_USE_SERVICE_URL=http://127.0.0.1:3001
PAPERCLIP_BROWSER_USE_SERVICE_SECRET=paperclip-browser-use-service-secret
PAPERCLIP_BROWSER_USE_SERVICE_TOKEN=paperclip-browser-use-service-token
# Redis (required for cost cache + browser-use nonce replay protection in multi-instance deployments)
PAPERCLIP_REDIS_URL=redis://127.0.0.1:6379
# Optional override for browser-use nonce store (defaults to PAPERCLIP_REDIS_URL)
PAPERCLIP_BROWSER_USE_NONCE_REDIS_URL=
# Optional: enable cost cache hit/miss debug logs
PAPERCLIP_COST_CACHE_DEBUG=false
# 設為 true/1/yes 時 Browser-Use 以可見視窗執行（方便觀察）；未設或 false 則 headless。Python 服務建議設相同值。
PAPERCLIP_BROWSER_USE_DEBUG=false

PAPERCLIP_ALLOWED_ATTACHMENT_TYPES=image/*,text/*,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/json

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=